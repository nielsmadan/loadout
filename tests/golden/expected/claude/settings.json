  "model": "opus",
  "hooks": {
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-fix-failures.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh PostToolUseFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/redirect-gh-api.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nudge-jina.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh SessionEnd",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve-mcp.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh PermissionRequest",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh SubagentStart",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/juggler/notify.sh StopFailure",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model_name=$(echo \"$input\" | jq -r '.model.display_name // \"Unknown Model\"'); output_style=$(echo \"$input\" | jq -r '.output_style.name // \"default\"'); current_dir=$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd'); dir_name=$(basename \"$current_dir\");git_info=\"\"; if git rev-parse --git-dir >/dev/null 2>&1; then branch=$(git branch --show-current 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || \"detached\"); git_status=\"\"; if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then git_status=\"●\"; else git_status=\"✓\"; fi; untracked_count=$(git ls-files --others --exclude-standard | wc -l | xargs); if [ \"$untracked_count\" -gt 0 ]; then git_status=\"${git_status}+${untracked_count}\"; fi; ahead_behind=\"\"; upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null); if [ -n \"$upstream\" ]; then ahead=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0); behind=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0); if [ \"$ahead\" -gt 0 ] && [ \"$behind\" -gt 0 ]; then ahead_behind=\"↕${behind}↑${ahead}↓\"; elif [ \"$ahead\" -gt 0 ]; then ahead_behind=\"↑${ahead}\"; elif [ \"$behind\" -gt 0 ]; then ahead_behind=\"↓${behind}\"; fi; fi; git_info=\"⎇ ${branch} ${git_status}${ahead_behind:+ $ahead_behind}\"; fi; project_type=\"\"; if [ -f \"$current_dir/pubspec.yaml\" ]; then if grep -q \"flutter:\" \"$current_dir/pubspec.yaml\" 2>/dev/null; then project_type=\"📱\"; else project_type=\"🎯\"; fi; fi; printf \"\\033[34m📁 %s\\033[0m\" \"$dir_name\"; printf \"\\033[2m │ \"; if [ -n \"$git_info\" ]; then printf \"\\033[32m%s\\033[0m\" \"$git_info\"; printf \"\\033[2m │ \"; fi; if [ -n \"$project_type\" ]; then printf \"\\033[35m%s Flutter\\033[0m\" \"$project_type\"; printf \"\\033[2m │ \"; fi; printf \"\\033[33m🤖 %s\\033[0m\" \"$model_name\"; printf \"\\033[2m │ \"; printf \"\\033[37m✨ %s\\033[0m\" \"$output_style\"; ctx_pct=$(echo \"$input\" | jq -r '.context_window.used_percentage // 0' | cut -d. -f1); if [ \"$ctx_pct\" -ge 80 ] 2>/dev/null; then ctx_color=\"\\033[31m\"; elif [ \"$ctx_pct\" -ge 50 ] 2>/dev/null; then ctx_color=\"\\033[33m\"; else ctx_color=\"\\033[32m\"; fi; printf \"\\033[2m │ \"; printf \"${ctx_color}🧠 %s%%\\033[0m\" \"$ctx_pct\"; printf \"\\033[0m\""
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "//tmp",
        "//private/tmp"
      ]
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": true,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}

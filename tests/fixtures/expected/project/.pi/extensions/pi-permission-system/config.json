{
  "permission": {
    "bash": {
      "*": "deny",
      "omicron build": "allow",
      "omicron build *": "allow",
      "alpha": "allow",
      "alpha *": "allow",
      "beta sub": "allow",
      "beta sub *": "allow",
      "gamma-*": "allow",
      "mu status": "allow",
      "kappa only-here": "allow",
      "kappa only-here *": "allow",
      "theta check": "ask",
      "theta check *": "ask",
      "omicron publish": "deny",
      "omicron publish *": "deny",
      "iota push": "deny",
      "iota push *": "deny",
      "nu wipe": "deny",
      "zeta": "deny",
      "zeta *": "deny"
    },
    "mcp__tmpl_server__*": "allow",
    "mcp__svc__*": "allow",
    "mcp__svc__write": "ask",
    "mcp__blocked__*": "deny"
  }
}

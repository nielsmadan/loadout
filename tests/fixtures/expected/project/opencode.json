{
  "$schema": "https://example.invalid/opencode.json",
  "permission": {
    "bash": {
      "*": "ask",
      "omicron build": "allow",
      "omicron build *": "allow",
      "alpha": "allow",
      "alpha *": "allow",
      "beta sub": "allow",
      "beta sub *": "allow",
      "gamma-*": "allow",
      "kappa only-here": "allow",
      "kappa only-here *": "allow",
      "omicron publish": "deny",
      "omicron publish *": "deny",
      "iota push": "deny",
      "iota push *": "deny",
      "zeta": "deny",
      "zeta *": "deny",
      "theta check": "ask",
      "theta check *": "ask"
    },
    "tmpl_server_*": "allow",
    "svc_*": "allow",
    "blocked_*": "deny",
    "svc_write": "ask"
  }
}

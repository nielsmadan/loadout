{
  "$schema": "https://example.invalid/opencode.json",
  "permission": {
    "bash": {
      "*": "deny",
      "omicron build": "allow",
      "omicron build *": "allow",
      "alpha": "allow",
      "alpha *": "allow",
      "beta sub": "allow",
      "beta sub *": "allow",
      "gamma-*": "allow",
      "kappa only-here": "allow",
      "kappa only-here *": "allow",
      "omicron publish": "deny",
      "omicron publish *": "deny",
      "iota push": "deny",
      "iota push *": "deny",
      "zeta": "deny",
      "zeta *": "deny",
      "theta check": "ask",
      "theta check *": "ask"
    },
    "tmpl_server_*": "allow",
    "svc_*": "allow",
    "blocked_*": "deny",
    "svc_write": "ask"
  },
  "mcp": {
    "jina": {
      "type": "remote",
      "url": "https://mcp.jina.ai/v1",
      "headers": {
        "Authorization": "Bearer {env:JINA_API_KEY}"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  }
}

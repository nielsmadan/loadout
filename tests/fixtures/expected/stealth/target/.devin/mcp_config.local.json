{
  "mcpServers": {
    "docs": {
      "url": "https://docs.example/mcp",
      "transport": "http",
      "headers": {
        "Authorization": "Bearer ${env:DOCS_TOKEN}"
      }
    },
    "local-tool": {
      "command": "npx",
      "args": [
        "-y",
        "local-tool-mcp"
      ],
      "transport": "stdio"
    }
  }
}

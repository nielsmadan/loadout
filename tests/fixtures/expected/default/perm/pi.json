{
  "$schema": "https://cdn.jsdelivr.net/npm/@gotgenes/pi-permission-system@23.0.0/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "alpha": "allow",
      "alpha *": "allow",
      "beta sub": "allow",
      "beta sub *": "allow",
      "gamma-*": "allow",
      "delta run --tag=*": "allow",
      "eta": "allow",
      "eta *": "allow",
      "mu status": "allow",
      "theta check": "ask",
      "theta check *": "ask",
      "zeta": "deny",
      "zeta *": "deny",
      "iota push": "deny",
      "iota push *": "deny",
      "nu wipe": "deny"
    },
    "mcp__*": "ask",
    "mcp__svc__*": "allow",
    "mcp__svc_two__read": "allow",
    "mcp__svc__write": "ask",
    "mcp__blocked__*": "deny",
    "mcp__svc__purge": "deny"
  }
}

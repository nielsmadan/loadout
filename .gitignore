.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
.coverage
htmlcov/

# Expected output mirrors harness paths, some of which a global gitignore
# excludes (.claude/, .codex/, .pi/, .aiconf/). Without this, `git add` skips
# them silently and a fresh clone fails the comparison. This must be repointed
# whenever the fixture tree moves — it was left aimed at tests/golden/ after the
# move here, and one file went untracked for exactly that reason.
!tests/fixtures/expected/**

# A worktree is a separate repository; committing one loses work and confuses
# every clone.
.claude/worktrees/
